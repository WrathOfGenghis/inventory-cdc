{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Inventory CDC pipeline — sync latency, throughput, lag, DLQ, schema drift, and reconciliation. Mirrors §10 of the design report.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "ms",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 3000 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(sync_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sync_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(sync_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "End-to-end sync latency (ms)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sync_latency_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "title": "Current p95 latency",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        }
      },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 9 },
      "id": 3,
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{consumergroup=\"inventory-orchestrator\"}",
          "legendFormat": "p{{partition}}",
          "refId": "A"
        }
      ],
      "title": "Consumer lag by partition",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 9 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(events_processed_total{result=\"applied\"}[1m]))",
          "legendFormat": "applied/s",
          "refId": "A"
        }
      ],
      "title": "Events processed / sec",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 9 },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (reason) (increase(events_dlq_total[1h]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "DLQ events (last 1h, by reason)",
      "type": "bargauge"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 18 },
      "id": 6,
      "targets": [
        {
          "expr": "increase(schema_warnings_total[1h])",
          "legendFormat": "warnings",
          "refId": "A"
        }
      ],
      "title": "Schema warnings (last 1h)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 18 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "inventory_mismatch_total",
          "refId": "A"
        }
      ],
      "title": "Active SKUs with mismatch",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 18 },
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(events_processed_total{result=\"applied\"}[5m])) / clamp_min(sum(rate(events_processed_total[5m])), 1)",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ],
      "title": "Website upsert success rate",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["inventory", "cdc", "kafka"],
